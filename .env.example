# Storage
BACKEND_STORE=json
TRANSLATOR_BACKEND_STORAGE=backend_storage

# Local development
TRANSLATOR_USE_FAKE_TRANSLATOR=false
TRANSLATOR_AUTH_MODE=local

# MySQL storage, used when BACKEND_STORE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=translator_backend
MYSQL_USER=root
MYSQL_PASSWORD=
TRANSLATOR_MYSQL_AUTO_CREATE_DATABASE=true
TRANSLATOR_MYSQL_AUTO_INIT_SCHEMA=true

# Translation provider: gemini or nvidia
MODEL_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini/gemini-3.1-pro

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google auth, used when TRANSLATOR_AUTH_MODE=google
GOOGLE_OAUTH_CLIENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
